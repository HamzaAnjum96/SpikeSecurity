---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.data.sitemap != false and not p.data.noindex and (p.url == '/' or p.url.endsWith('.html')) %}
  <url><loc>{{ site.url }}{{ p.url | canon }}</loc><lastmod>{{ p.date.toISOString().slice(0, 10) }}</lastmod></url>
{%- endif %}{% endfor %}
</urlset>
