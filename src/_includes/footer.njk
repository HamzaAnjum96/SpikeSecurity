<footer class="foot">
  <div class="wrap">
    <div class="foot-top">
      <a href="/" class="foot-brand" aria-label="Spike Security home"><svg viewBox="0 0 2080.8 453.19" aria-hidden="true" focusable="false"><use href="#ss-horizontal"/></svg></a>
      <nav class="foot-nav" aria-label="Footer">
        <ul>{% for item in site.nav %}<li><a href="{{ item.url }}">{{ item.label }}</a></li>{% endfor %}</ul>
      </nav>
    </div>
    <div class="foot-contact">
      <p><a class="foot-big" translate="no" href="{{ site.phoneHref }}">{{ site.phone }}</a><span class="muted">Answered 24 hours</span></p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><a href="mailto:{{ site.careersEmail }}">{{ site.careersEmail }}</a></p>
      <p><span>{{ site.office.street }}, {{ site.office.city }} {{ site.office.postcode | replace(" ", "&nbsp;") | safe }}</span><span class="muted">Office: {{ site.office.hours }}</span></p>
    </div>
    <div class="foot-legal">
      <p>{{ site.legalName }}. Registered in England and Wales, company number <span class="data" translate="no">{{ site.companyNumber }}</span>. Registered office: {{ site.registeredOffice }}.</p>
      <ul><li><a href="/legal">Legal</a></li><li><a href="/privacy">Privacy</a></li><li><a href="/sitemap">Site map</a></li><li><a href="/branding">Brand</a></li><li><button type="button" class="foot-cookies" data-consent-open>Cookie settings</button></li></ul>
    </div>
  </div>
</footer>
