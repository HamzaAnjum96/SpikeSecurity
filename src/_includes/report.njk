{# A sample record, drawn from src/_data/reports.json. Set `report` before including it; the home sample is the default. #}
{% set r = report or reports.home %}
<article class="doc" aria-label="Sample {{ r.title | lower }}">
  <header class="doc-head">
    <div class="doc-id"><svg viewBox="0 0 351.64 453.19" aria-hidden="true" focusable="false"><use href="#ss-shield"/></svg><b>{{ r.title }}</b></div>
    <p class="doc-ref"><span class="nb">Ref. <span class="data" translate="no">{{ r.ref }}</span></span><br>Sample</p>
  </header>
  <dl class="doc-meta">
    {% for m in r.meta %}<div><dt>{{ m[0] }}</dt>{% if m[2] %}<dd class="data">{{ m[1] }}</dd>{% else %}<dd>{{ m[1] | mono | safe }}</dd>{% endif %}</div>
    {% endfor %}
  </dl>
  <table class="doc-log">
    <caption>Log</caption>
    <tbody>
      {% for l in r.log %}<tr><th scope="row" class="data">{{ l[0] }}</th><td>{{ l[1] | monotimes | safe }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  <footer class="doc-foot"><span>{{ r.by | replace(". ", ".&nbsp;") | safe }}</span><span>Sent <span class="data">{{ r.sent }}</span></span></footer>
</article>
