{% macro arrow() %}<svg class="arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 12h16M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"/></svg>{% endmacro %}

{# The phone number in running text: a link, in Martian Mono, never broken across lines #}
{% macro phone(site) %}<a class="link data nb" translate="no" href="{{ site.phoneHref }}">{{ site.phone }}</a>{% endmacro %}

{# Section opening: a statement headline, with an optional supporting sentence. No label above, no number. #}
{% macro head(id, title, lede, tag="h2") %}
<div class="sec-head">
  <{{ tag }} class="sec-title" id="{{ id }}">{{ title | safe }}</{{ tag }}>
  {% if lede %}<p class="sec-lede">{{ lede | safe }}</p>{% endif %}
</div>
{% endmacro %}

{% macro serviceRows(services) %}
<ul class="svc">
  {% for s in services %}
  <li><a href="/{{ s.slug }}"><span class="svc-name">{{ s.name }}</span><span class="svc-desc">{{ s.short }}</span><span class="svc-for">{{ s.bestFor }}</span>{{ arrow() }}</a></li>
  {% endfor %}
</ul>
{% endmacro %}

{% macro faqs(items, headingId="faq-title", title="Questions") %}
<div class="faq">
  {% for f in items %}
  <details>
    <summary><h3>{{ f.q }}</h3><span class="faq-mark" aria-hidden="true"></span></summary>
    <p>{{ f.a | safe }}</p>
  </details>
  {% endfor %}
</div>
{% endmacro %}

{# The orange finale: the 24-hour number set at full width, like a road sign #}
{% macro finale(site, text, cta="Get a quote", href="/contact#quote") %}
<section class="sec sec--signal" aria-labelledby="finale-title">
  <div class="wrap finale">
    <h2 id="finale-title"><span class="sr-only">Call us, 24 hours, every day: </span><a class="finale-tel" translate="no" href="{{ site.phoneHref }}">{{ site.phone | replace(" ", "&nbsp;") | safe }}</a></h2>
    <div class="finale-row">
      <p>{{ text | safe }}</p>
      {% if cta %}<a class="btn btn--dark btn--lg" href="{{ href }}">{{ cta }}</a>{% endif %}
      <svg class="finale-lockup" viewBox="0 0 860.23 627.06" aria-hidden="true" focusable="false"><use href="#ss-stacked"/></svg>
    </div>
  </div>
</section>
{% endmacro %}

{# A real street map (Leaflet, OpenStreetMap tiles darkened to the brand) behind a one-click consent gate.
   The area map's gate is a drawn coverage diagram, so the section works without the street map. #}
{% macro map(site, mode="area", label="Map", reach=null) %}
<figure class="map" data-map="{{ mode }}" data-lat="{{ site.office.lat }}" data-lon="{{ site.office.lon }}"{% if reach %} data-bounds='{{ reach.bounds | dump | safe }}'{% endif %}>
  <div class="map-frame">
    <div class="map-canvas" role="region" aria-label="{{ label }}" tabindex="-1"></div>
    {% if mode == "area" and reach %}
    <div class="map-gate map-gate--reach">
      <div class="reach">
        {% for r in reach.rings %}<span class="reach-ring" style="--r: {{ r.km }}" aria-hidden="true"></span>{% endfor %}
        {% for r in reach.rings %}<span class="reach-ring-label reach-ring-label--{{ r.mi }} data" style="--r: {{ r.km }}" aria-hidden="true">{{ r.mi }} mi</span>{% endfor %}
        <p class="reach-office"><svg viewBox="0 0 351.64 453.19" aria-hidden="true" focusable="false"><use href="#ss-shield"/></svg><span>Our office</span></p>
        <ul class="reach-list" aria-label="Distance from our office">
          {% for t in reach.points %}<li class="reach-pt reach-pt--{{ t.label }}" style="--x: {{ t.x }}; --y: {{ t.y }}"><b>{{ t.name }}</b><span class="data">{{ t.miles }}<span aria-hidden="true"> mi</span><span class="sr-only"> miles</span></span></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% else %}
    <div class="map-gate">
      <svg class="map-gate-pin" viewBox="0 0 351.64 453.19" aria-hidden="true" focusable="false"><use href="#ss-shield"/></svg>
      <button class="btn btn--ghost btn--sm map-on" type="button">Show the street map</button>
      <p class="map-gate-note">The map loads from OpenStreetMap, so it needs your OK first.</p>
    </div>
    {% endif %}
  </div>
  <figcaption>
    {% if mode == "area" and reach %}
    <p class="reach-key">Straight-line distance from our office<span class="reach-key-rings">, with rings at {{ reach.rings[0].mi }} and {{ reach.rings[1].mi }} miles</span>.</p>
    <p class="reach-street"><button class="btn btn--ghost btn--sm map-on" type="button">Show the street map</button><span class="map-gate-note">It loads from OpenStreetMap, so it needs your OK first.</span></p>
    {% endif %}
    <span class="map-credit" hidden>Map © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap contributors</a>. <button type="button" class="map-off">Turn the map off</button></span>{% if mode == "office" %}<a class="map-directions" href="https://www.google.com/maps/search/?api=1&amp;query={{ site.office.lat }}%2C{{ site.office.lon }}" rel="noopener">Directions in Google Maps</a>{% endif %}
  </figcaption>
</figure>
{% endmacro %}

{# Inner page opening: the statement is the h1; no label above it #}
{% macro pagehead(title, lede="", actions="") %}
<header class="page-head">
  <div class="wrap page-head-grid">
    <h1 class="page-title">{{ title | safe }}</h1>
    {% if lede %}<p class="page-lede">{{ lede | safe }}</p>{% endif %}
    {% if actions %}<div class="page-actions">{{ actions | safe }}</div>{% endif %}
  </div>
</header>
{% endmacro %}
