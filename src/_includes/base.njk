<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# "About Spike Security", not "About Spike Security | Spike Security"; the home page says what Spike does #}
{% set fullTitle = ((title + " | Spike Security") if not ("Spike Security" in title) else title) if title else "Spike Security | Licensed security officers in Manchester" %}
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ description }}">
{% set canonPath = page.url | canon %}
<link rel="canonical" href="{{ site.url }}{{ canonPath }}">
{% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
{# the same page as plain Markdown, for AI tools and readers (written after the build by lib/markdown.mjs) #}
<link rel="alternate" type="text/markdown" href="{{ '/index.md' if canonPath == '/' else canonPath + '.md' }}" title="{{ fullTitle }} (Markdown)">{% endif %}
<meta name="theme-color" content="#0B0C0E">
<meta name="color-scheme" content="dark">
<meta name="format-detection" content="telephone=no">
{# Link previews (WhatsApp, iMessage, LinkedIn, Facebook, Slack, X): each main page has its own card,
   made by scripts/og/cards.cjs; every other page uses the home card #}
{% set ogSlug = (page.url | canon | replace("/", "")) or "home" %}
{% if not og[ogSlug] %}{% set ogSlug = "home" %}{% endif %}
{% set ogCard = og[ogSlug] %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Spike Security">
<meta property="og:locale" content="en_GB">
<meta property="og:title" content="{{ fullTitle if title else 'Spike Security: licensed security for Manchester and the North West' }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url | canon }}">
<meta property="og:image" content="{{ site.url }}/assets/og/{{ ogSlug }}.png?v={{ ogCard.v }}">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogCard.alt }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ site.url }}/assets/og/{{ ogSlug }}.png?v={{ ogCard.v }}">
<meta name="twitter:image:alt" content="{{ ogCard.alt }}">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href="/assets/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/martian-mono-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/site.css?v={{ build }}">
{# One connected graph per page: business, website, page, breadcrumbs, service, questions (lib/jsonld.mjs) #}
{% if not noindex %}<script type="application/ld+json">{{ { url: site.url + canonPath, title: fullTitle, description: description, pageType: pageType, crumb: crumb, crumbParent: crumbParent, svcSlug: (svc.slug if svc else null), faqs: (contactFaqs if pageType == "ContactPage" else null), image: site.url + "/assets/og/" + ogSlug + ".png", modified: page.date.toISOString().slice(0, 10) } | jsonld | safe }}</script>{% endif %}
<script src="/assets/js/site.js?v={{ build }}" defer></script>
</head>
<body class="{{ bodyClass }}">
{% include "symbols.njk" %}
<a class="skip" href="#main">Skip to content</a>
{% include "bar.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "footer.njk" %}
<section class="consent" id="consent" aria-labelledby="consent-title" hidden>
  <h2 class="consent-title" id="consent-title">Cookies and maps</h2>
  <p>No tracking or advertising cookies. Our maps load from OpenStreetMap, which sees your IP address. <a class="link" href="/privacy#cookies">More about cookies</a></p>
  <div class="consent-actions">
    <button type="button" class="btn btn--ghost btn--sm" data-allow>Allow maps</button>
    <button type="button" class="btn btn--ghost btn--sm" data-deny>No thanks</button>
  </div>
</section>
{% if dock != false %}{% include "dock.njk" %}{% endif %}
</body>
</html>
