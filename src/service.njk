---
pagination:
  data: services
  size: 1
  alias: svc
permalink: "/{{ svc.slug }}.html"
section: Services
crumbParent:
  name: Services
  url: /services
eleventyComputed:
  title: "{{ svc.title }}"
  description: "{{ svc.description }}"
  crumb: "{{ svc.name }}"
---
{% from "macros.njk" import pagehead, serviceRows, faqs, finale, arrow %}
{% set quoteHref = "/contact?service=" + svc.slug + "#quote" %}
{{ pagehead(svc.headline, svc.lede, '<a class="btn btn--primary btn--lg" href="' + quoteHref + '">Get a quote</a><a class="tel" href="' + site.phoneHref + '"><span class="tel-l">Need cover tonight? Call 24/7</span><span class="tel-n" translate="no">' + site.phone + '</span></a>') }}

<section class="sec" aria-labelledby="inc-title">
  <div class="wrap">
    <div class="sec-head">
      <h2 class="sec-title" id="inc-title">What you get.</h2>
    </div>
    <div class="inc-grid">
      <ul class="inc">
        {% for i in svc.includes %}<li><h3>{{ i.h }}</h3><p>{{ i.p }}</p></li>{% endfor %}
      </ul>
      <div class="good-for">
        <h3>Good for</h3>
        <ul>{% for g in svc.goodFor %}<li>{{ g }}</li>{% endfor %}</ul>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": svc.name,
  "serviceType": svc.name,
  "description": svc.description,
  "url": site.url + "/" + svc.slug,
  "areaServed": site.areas,
  "provider": { "@type": "LocalBusiness", "@id": site.url + "/#business", "name": site.name, "telephone": site.phoneE164, "url": site.url + "/" }
} | json | safe }}</script>

{% set report = reports[svc.slug] or reports.home %}
<section class="sec sec--paper" aria-labelledby="record-title">
  <div class="wrap record record--svc">
    <div>
      <div class="sec-head">
        <h2 class="sec-title" id="record-title">{{ report.recordTitle }}</h2>
      </div>
      <p class="record-lede">{{ report.recordLede }}</p>
      <a class="link link--solo record-more" href="/how-we-work">How we vet, brief and report{{ arrow() }}</a>
    </div>
    <figure class="doc-fig">
      {% include "report.njk" %}
      <figcaption>A sample with invented details.</figcaption>
    </figure>
  </div>
</section>

{% include "steps.njk" %}

<section class="sec" aria-labelledby="faq-title">
  <div class="wrap faq-wrap">
    <div class="sec-head">
      <h2 class="sec-title" id="faq-title">Questions we get asked.</h2>
    </div>
    {{ faqs(svc.faqs) }}
  </div>
</section>

<section class="sec" aria-labelledby="other-title">
  <div class="wrap">
    <div class="sec-head"><h2 class="sec-title" id="other-title">Other services.</h2></div>
    {{ serviceRows(services | reject("equalto", svc)) }}
  </div>
</section>

{{ finale(site, "<b>Answered 24 hours, every day.</b> Tell us the site, the dates and the hours, and we’ll reply with a price and the officers we’d send.", "Get a quote", quoteHref) }}
